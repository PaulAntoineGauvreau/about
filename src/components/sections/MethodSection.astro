---
import { workPrinciples } from '../../data/profile';
import MethodCard from '../MethodCard.astro';
import SectionHeading from '../SectionHeading.astro';
---

<section id="methode" class="bg-foreground px-gutter pt-section text-surface" aria-labelledby="method-title">
  <SectionHeading number="02" eyebrow="Ma façon de travailler" title="" id="method-title" />
  <div data-method-stack>
    <div class="min-h-stack-stage" data-method-stage>
      {workPrinciples.map((principle, index) => <MethodCard principle={principle} index={index} />)}
    </div>
  </div>
</section>
