---
import { profile } from '../../data/profile';
---

<section id="contact" class="flex min-h-svh flex-col justify-between bg-primary px-4 pt-20 pb-8 bp:px-12 bp:pt-40" aria-labelledby="contact-title">
  <p class="text-overline m-0">05 · Contact</p>
  <h2 id="contact-title" class="text-heading-large my-12">On devrait<br />se parler.</h2>
  <div class="flex flex-col items-start justify-between gap-x-8 gap-y-4 border-t border-foreground pt-5 bp:flex-row bp:flex-wrap bp:items-center">
    <copy-email class="flex flex-wrap items-center gap-3" data-email={profile.email}>
      <a class="text-contact" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button class="text-button hidden cursor-pointer rounded-full border border-current bg-transparent px-3 py-1" type="button" data-copy-button>Copier</button>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </copy-email>
    <a class="text-contact" href={`tel:${profile.phoneHref}`}>{profile.phoneDisplay}</a>
  </div>
</section>
