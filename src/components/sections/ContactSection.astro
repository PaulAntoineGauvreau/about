---
import { profile } from '../../data/profile';
import Button from '../Button.astro';
---

<section id="contact" class="sticky bottom-0 z-0 flex flex-col justify-between bg-foreground px-gutter pt-0 pb-8 text-surface" aria-labelledby="contact-title">
  <p class="m-0 font-mono text-fluid-overline font-bold uppercase">Contact</p>
  <h2 id="contact-title" class="my-12 font-sans text-fluid-heading-large text-balance [overflow-wrap:anywhere]">Prenons un café ☕ !!!</h2>
  <div class="flex flex-col items-start justify-between gap-4 border-t border-border-inverse pt-5 bp:flex-row bp:flex-wrap bp:items-center">
    <copy-email class="flex flex-wrap items-center gap-3" data-email={profile.email}>
      <a class="font-sans text-fluid-body font-bold" href={`mailto:${profile.email}`}>{profile.email}</a>
      <Button variant="filter" class="hidden" data-copy-button>Copier</Button>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </copy-email>
    <a class="font-sans text-fluid-body font-bold" href={`tel:${profile.phoneHref}`}>{profile.phoneDisplay}</a>
  </div>
</section>
