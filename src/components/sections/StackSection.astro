---
import { stackGroups } from '../../data/profile';
import SectionHeading from '../SectionHeading.astro';
---

<section class="bg-surface px-gutter py-section" aria-labelledby="stack-title">
  <SectionHeading eyebrow="Stack" title="Des outils choisis selon le projet." id="stack-title" centered />
  <div class="grid grid-cols-1 border-t border-l border-border bp:grid-cols-4">
    {
      stackGroups.map((group) => (
        <article class="bp:min-h-static-card min-h-none border-r border-b border-border p-5 bp:p-8">
          <h3 class="mt-0 bp:mb-12 mb-4 font-mono text-fluid-caption font-bold uppercase">{group.title}</h3>
          <clip-line-reveal class="block">
            <ul class="m-0 list-none p-0 grid grid-cols-2 bp:grid-cols-1">
              {group.items.map((item) => <li class="font-sans text-fluid-title-medium" data-clip-reveal-line>{item}</li>)}
            </ul>
          </clip-line-reveal>
        </article>
      ))
    }
  </div>
</section>
