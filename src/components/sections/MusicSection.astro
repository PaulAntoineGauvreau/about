---
import { getMusicFavorites } from '../../data/portfolio';
import MusicCard from '../MusicCard.astro';

const favorites = getMusicFavorites();
---

<section id="musique" class="overflow-hidden bg-foreground py-section text-surface" aria-labelledby="music-title">
  <div class="px-gutter">
    <p class="m-0 font-mono text-fluid-overline font-bold uppercase">Coups de cœur musicaux</p>
    <clip-line-reveal class="block">
      <h2 id="music-title" class="mt-4 mb-0 max-w-heading-wide text-balance font-sans text-fluid-heading-medium" data-clip-reveal-line>Dans mes écouteurs live !
      </h2>
    </clip-line-reveal>
  </div>

  <music-preview class="relative block">
    <div class="group/marquee mt-16 overflow-hidden motion-reduce:overflow-x-auto">
      <div class="flex w-max animate-marquee will-change-transform group-hover/marquee:[animation-play-state:paused] group-focus-within/marquee:[animation-play-state:paused] motion-reduce:animate-none motion-reduce:transform-none motion-reduce:will-change-auto">
        <div class="flex gap-gutter pr-gutter">
          {favorites.map((favorite) => <MusicCard favorite={favorite} />)}
        </div>
        <div class="flex gap-gutter pr-gutter motion-reduce:hidden" aria-hidden="true">
          {favorites.map((favorite) => <MusicCard favorite={favorite} duplicate />)}
        </div>
      </div>
    </div>
    <audio class="hidden" preload="none" data-music-player></audio>
    <p class="sr-only" aria-live="polite" data-music-status></p>
  </music-preview>
</section>
