---
import { profile } from '../../data/profile';
---

<section class="relative flex min-h-svh flex-col justify-between overflow-hidden bg-primary px-4 pt-24 pb-8 md:px-8 md:pt-32 lg:px-12 lg:pt-36" aria-labelledby="hero-title">
  <div class="text-overline flex justify-between gap-4">
    <p class="m-0">Développeur front-end</p>
    <montreal-weather>
      <p class="m-0 text-right" aria-live="polite">
        <span>Montréal, QC</span>
        <span data-weather hidden>
          <span aria-hidden="true"> · </span><span data-temperature></span>
          <span aria-hidden="true"> · </span><span data-bike aria-hidden="true"></span>
          <span class="sr-only" data-bike-label></span>
        </span>
      </p>
    </montreal-weather>
  </div>

  <h1
    id="hero-title"
    class="text-display my-12 md:my-20 lg:my-28"
    aria-label={profile.name}
  >
    <span class="block overflow-hidden pr-1"><span class="block will-change-transform" data-hero-line>Paul-Antoine</span></span>
    <span class="block overflow-hidden pr-1"><span class="block will-change-transform" data-hero-line>Gauvreau</span></span>
  </h1>

  <div class="mt-auto grid items-end gap-8 lg:grid-cols-12">
    <p class="text-lead m-0 max-w-136 lg:col-span-7">{profile.introduction}</p>
    <div class="text-body flex items-start gap-3 border-t border-foreground pt-4 lg:col-span-4 lg:col-start-9">
      <span aria-hidden="true">✦</span>
      <p class="m-0"><strong>Premier projet Astro.</strong> Construit pour apprendre l’outil en produisant une preuve concrète.</p>
    </div>
  </div>

  <a class="text-button group mt-10 inline-flex items-center gap-3 self-end no-underline" href="#projets">
    Voir les projets
    <span class="grid size-8 place-items-center rounded-full border border-current transition-transform duration-200 group-hover:translate-y-1" aria-hidden="true">↓</span>
  </a>
</section>
