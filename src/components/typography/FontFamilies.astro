---
import { fontFamilies } from '../../data/typography';
import TypeSpecimen from './TypeSpecimen.astro';
---

<section class="px-4 py-20 md:px-8 md:py-28 lg:px-12 lg:py-40" aria-labelledby="font-families-title">
  <p class="text-overline m-0">01 · Familles</p>
  <h2 id="font-families-title" class="text-heading-medium mt-4 mb-16 max-w-240">Deux voix, un même système.</h2>
  <div>
    {fontFamilies.map((font) => <TypeSpecimen {...font} />)}
  </div>
</section>
