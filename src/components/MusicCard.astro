---
import type { MusicFavorite } from '../data/portfolio';

interface Props {
  favorite: MusicFavorite;
  duplicate?: boolean;
}

const { favorite, duplicate = false } = Astro.props;
---

<article
  class="group/music relative isolate flex min-h-music-card w-music-card flex-none overflow-hidden rounded-card border border-border-inverse p-5 text-surface"
  data-music-card
  data-spotify-card={favorite.spotifyUri ? '' : undefined}
  data-spotify-uri={favorite.spotifyUri}
>
  {favorite.coverImage && <img class="absolute inset-0 -z-20 size-full object-cover" src={favorite.coverImage} alt="" loading="lazy" decoding="async" />}
  {favorite.coverImage && <span class="absolute inset-0 -z-10 bg-music-overlay" aria-hidden="true"></span>}

  <div class="flex w-full flex-col justify-between">
    <p class="m-0 font-mono text-fluid-overline font-bold uppercase">{favorite.note}</p>
    <div class="flex items-end justify-between gap-4">
      <div>
        <h3 class="m-0 font-sans text-fluid-title-medium">{favorite.artist}</h3>
        <p class="mt-2 mb-0 font-mono text-fluid-body text-muted-inverse">{favorite.title}</p>
      </div>

      {favorite.spotifyUri && (
        <button
          type="button"
          class="grid size-12 flex-none cursor-pointer place-items-center rounded-full border border-surface bg-surface text-foreground transition-colors duration-project ease-in hover:bg-transparent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          aria-label={`Lire ${favorite.title} de ${favorite.artist}`}
          aria-pressed="false"
          tabindex={duplicate ? -1 : undefined}
          data-spotify-toggle
          data-play-label={`Lire ${favorite.title} de ${favorite.artist}`}
          data-pause-label={`Mettre ${favorite.title} en pause`}
        >
          <svg class="size-5 fill-current group-data-[playing]/music:hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          <svg class="hidden size-5 fill-current group-data-[playing]/music:block" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"></path></svg>
        </button>
      )}
    </div>
  </div>
</article>
