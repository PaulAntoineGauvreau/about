---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  id?: string;
}

const { number, eyebrow, title, id } = Astro.props;
---

<div class="mb-12 grid grid-cols-4 items-start gap-4 md:mb-20 lg:mb-28">
  <p class="text-overline col-span-1 m-0" aria-hidden="true">{number}</p>
  <div class="col-span-3">
    <p class="text-overline mt-0 mb-4">{eyebrow}</p>
    <h2 class="text-heading-medium m-0 max-w-240" id={id}>{title}</h2>
  </div>
</div>
