---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  id?: string;
}

const { number, eyebrow, title, id } = Astro.props;
const heading = title || eyebrow;
---

<div class="mb-12 bp:mb-14">
  <p class="hidden" aria-hidden="true">{number}</p>
  <div>
    <p class="mt-0 mb-4 font-mono text-fluid-overline font-bold uppercase">{eyebrow}</p>
    <h2 class:list={[title ? 'm-0 max-w-heading-wide font-sans text-fluid-heading-medium text-balance' : 'sr-only']} id={id}>{heading}</h2>
  </div>
</div>
