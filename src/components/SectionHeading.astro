---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  centered?: boolean;
  class?: string;
}

const { eyebrow, title, id, centered = false, class: className } = Astro.props;
---

<div class:list={['mb-12 bp:mb-14', className]}>
  <div class:list={{ 'text-center': centered }}>
    <p class="mt-0 mb-4 font-mono text-fluid-overline font-bold uppercase">{eyebrow}</p>
    <h2 class:list={['m-0 max-w-heading-wide text-balance font-sans text-fluid-heading-medium', { 'mx-auto': centered }]} id={id}>{title}</h2>
  </div>
</div>
