---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  id?: string;
}

const { number, eyebrow, title, id } = Astro.props;
---

<div class="mb-12 grid grid-cols-4 items-start gap-4 md:mb-20 lg:mb-28">
  <p class="col-span-1 m-0 text-3 font-bold tracking-8 uppercase" aria-hidden="true">{number}</p>
  <div class="col-span-3">
    <p class="mt-0 mb-4 text-3 font-bold tracking-8 uppercase">{eyebrow}</p>
    <h2 class="m-0 max-w-240 text-10 leading-92 font-extrabold -tracking-8 md:text-18 lg:text-29" id={id}>{title}</h2>
  </div>
</div>
