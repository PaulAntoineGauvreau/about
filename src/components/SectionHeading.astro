---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  centered?: boolean;
  class?: string;
}

const { eyebrow, title, id, centered = false, class: className } = Astro.props;
---

<clip-line-reveal class:list={['mb-12 block bp:mb-14', className]}>
  <div class:list={{ 'text-center': centered }}>
    <div class="_reveal-clip mb-4">
      <p class="_reveal-line m-0 font-mono text-fluid-overline font-bold uppercase" data-clip-reveal-line>{eyebrow}</p>
    </div>
    <div class="_reveal-clip">
      <h2 class:list={['_reveal-line m-0 max-w-heading-wide font-sans text-fluid-heading-medium', { 'mx-auto text-center': centered, 'text-balance': !centered }]} id={id} data-clip-reveal-line>{title}</h2>
    </div>
  </div>
</clip-line-reveal>
