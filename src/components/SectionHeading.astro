---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  centered?: boolean;
  class?: string;
}

const { eyebrow, title, id, centered = false, class: className } = Astro.props;
const titleWords = title.split(' ');
---

<clip-line-reveal class:list={['mb-12 block bp:mb-14', className]} data-section-heading-reveal>
  <div class:list={{ 'text-center': centered }}>
    <div class="_reveal-clip mb-4">
      <p class="_reveal-line m-0 font-mono text-fluid-overline font-bold uppercase" data-clip-reveal-line>{eyebrow}</p>
    </div>
    <div class="_reveal-clip _heading-reveal-clip">
      <h2 class:list={['_reveal-line m-0 max-w-heading-wide font-sans text-fluid-heading-medium', { 'mx-auto text-center': centered, 'text-balance': !centered }]} id={id} aria-label={title} data-heading-lines>
        {
          titleWords.map((word, index) => (
            <>
              <span class="inline-block" data-clip-reveal-line data-heading-word aria-hidden="true">{word}</span>
              {index < titleWords.length - 1 && ' '}
            </>
          ))
        }
      </h2>
    </div>
  </div>
</clip-line-reveal>
