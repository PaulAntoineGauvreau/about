---
import { getProjects } from '../data/portfolio';
import Button from './Button.astro';
import ProjectCard from './ProjectCard.astro';

const projects = getProjects();
const filters = [
  { value: 'all', label: 'Tous', className: 'order-1' },
  { value: 'headless', label: 'Headless', className: 'order-3 bp:order-2' },
  { value: 'wordpress', label: 'WordPress', className: 'order-4 bp:order-3' },
  { value: 'commerce', label: 'Commerce', className: 'order-2 bp:order-4' },
] as const;
---

<project-filter class="block">
  <div class="mb-8 hidden flex-nowrap gap-2 overflow-x-auto bp:overflow-visible" aria-label="Filtrer les projets" data-filter-controls>
    {
      filters.map((filter, index) => (
        <Button
          variant="filter"
          data-filter={filter.value}
          pressed={index === 0}
          class={filter.className}
        >
          {filter.label}
        </Button>
      ))
    }
  </div>
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <div class="grid grid-cols-1 gap-y-4 bp:grid-cols-2 bp:gap-x-8 bp:gap-y-8" data-project-grid>
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</project-filter>
