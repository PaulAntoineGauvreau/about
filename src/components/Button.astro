---
interface Props {
  variant?: 'primary' | 'filter' | 'icon';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  pressed?: boolean;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  pressed,
  label,
  class: className,
  ...attributes
} = Astro.props;
const variants = {
  primary: 'min-h-11 rounded-2 border-transparent bg-accent px-4 pt-1 pb-0 leading-100 text-foreground hover:bg-white',
  filter: 'min-h-8 [border-width:0_0_1px] border-transparent bg-transparent px-1 pt-1 pb-0 leading-100 hover:border-current aria-pressed:border-current',
  icon: 'border-transparent bg-transparent',
};
const classes = [
  'inline-flex cursor-pointer items-center justify-center gap-3 border font-mono text-fluid-caption font-bold uppercase no-underline transition-colors duration-fast',
  variants[variant],
  className,
];
---

{
  href ? (
    <a class:list={classes} href={href} aria-label={label} {...attributes}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} aria-pressed={pressed} aria-label={label} {...attributes}>
      <slot />
    </button>
  )
}
