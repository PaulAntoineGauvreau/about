---
import { Picture } from 'astro:assets';
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group/card min-w-0 rounded-6 border-1 border-border bg-white p-4"
  data-project-card
  data-category={project.category}
  data-accent={project.accent}
>
  <a class="block no-underline" href={project.url} target="_blank" rel="noopener noreferrer">
    <div class="_clip-project-image relative h-project-image">
      <Picture
        src={project.image}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[320, 640, 656, 704, 960, 1440]}
        sizes="(min-width: 1024px) calc((100vw - 5.6rem) / 2), calc(100vw - 3.2rem)"
        alt={`Aperçu du site ${project.name}`}
        loading="lazy"
        fetchpriority="auto"
        class="border-1 border-border block size-full rounded-2 grayscale object-cover object-top transition-project-image duration-project ease-expo-out group-hover/card:grayscale-0 w-full"
      />
    </div>
    <div>
      <div class="min-h-19 pt-5">
        <h3 class="m-0 whitespace-nowrap font-sans text-fluid-title-large">{project.name}</h3>
      </div>
      <div class="max-w-copy">
        <div class="pt-2 pb-3 font-mono text-fluid-caption font-bold uppercase">
          {project.role}
        </div>
      </div>
      <span class="sr-only">{project.summary} Visiter le site dans un nouvel onglet.</span>
    </div>
  </a>
  <p class="mt-0 mb-3 font-mono text-fluid-caption font-bold uppercase">
    {
      project.team.url ? (
        <a class="underline decoration-1 underline-offset-4" href={project.team.url} target="_blank" rel="noopener noreferrer">
          {project.team.name}
        </a>
      ) : (
        <span>{project.team.name}</span>
      )
    }
  </p>
  <ul class="flex list-none flex-wrap items-start gap-2" aria-label={`Technologies utilisées pour ${project.name}`}>
    {project.stack.map((item) => <li class="inline-flex min-h-8 items-center justify-center rounded-full border border-border px-2 pt-1 pb-0 font-mono text-fluid-caption font-bold leading-100 uppercase">{item}</li>)}
  </ul>
</article>
