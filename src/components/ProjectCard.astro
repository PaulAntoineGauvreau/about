---
import { Picture } from 'astro:assets';
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group/card min-w-0 rounded-6 border-1 border-border bg-white p-4"
  data-project-card
  data-category={project.category}
>
  <a class="block min-h-11 rounded-2 no-underline" href={project.url} target="_blank" rel="noopener noreferrer">
    <div class="_clip-project-image relative h-project-image">
      <Picture
        src={project.image}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[320, 640, 656, 704, 960, 1440]}
        sizes="(min-width: 1024px) calc((100vw - 5.6rem) / 2), calc(100vw - 3.2rem)"
        alt={project.imageAlt}
        loading="lazy"
        fetchpriority="auto"
        class="border-1 border-border block size-full rounded-2 grayscale object-cover object-top transition-project-image duration-project ease-expo-out group-hover/card:grayscale-0 w-full"
      />
    </div>
    <div>
      <div class="min-h-19 pt-5">
        <h3 class="m-0 whitespace-nowrap font-sans text-fluid-title-large">{project.name}</h3>
      </div>
      <div class="max-w-copy">
        <div class="pt-2 font-mono text-fluid-caption font-bold uppercase">
          <span class="_project-role-line">{project.role}</span>
        </div>
      </div>
      <span class="sr-only">Visiter le site dans un nouvel onglet.</span>
    </div>
  </a>
  <p class="font-mono text-fluid-caption font-bold uppercase">
    {
      project.team.url ? (
        <a class="-mx-2 inline-flex min-h-11 items-center rounded-2 px-2 underline decoration-1 underline-offset-4" href={project.team.url} target="_blank" rel="noopener noreferrer">
          {project.team.name}
        </a>
      ) : (
        <span class="-mx-2 inline-flex min-h-11 items-center px-2">{project.team.name}</span>
      )
    }
  </p>
  <p class="mt-0 mb-4 max-w-[60ch] font-sans text-fluid-body-small">{project.summary}</p>
  <ul class="flex list-none flex-wrap items-baseline gap-y-1" aria-label={`Technologies utilisées pour ${project.name}`}>
    {
      project.stack.map((item, index) => (
        <li class="inline-flex items-baseline font-mono text-fluid-caption font-bold uppercase">
          {item}
          {index < project.stack.length - 1 && <span class="mx-2 text-border" aria-hidden="true">·</span>}
        </li>
      ))
    }
  </ul>
</article>
