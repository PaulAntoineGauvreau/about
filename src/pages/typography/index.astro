---
import TypographyList from '../../components/typography/TypographyList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Système typographique — Paul-Antoine Gauvreau"
  description="Liste simple du système typographique fluide du portfolio de Paul-Antoine Gauvreau, du plus grand au plus petit."
  canonicalPath="/typography/"
>
  <main id="contenu" tabindex="-1">
    <header class="bg-primary px-4 pt-32 pb-12 bp:px-12 bp:pt-48 bp:pb-20">
      <h1 class="text-title-large m-0">Typographie</h1>
      <p class="text-body mt-4 mb-0">Du plus grand au plus petit.</p>
    </header>

    <section class="bg-surface px-4 py-12 bp:px-12 bp:py-20" aria-label="Échelle typographique">
      <TypographyList />
    </section>

    <div class="bg-accent px-4 py-12 bp:px-12">
      <a class="text-link" href="/">← Retour au portfolio</a>
    </div>
  </main>
</BaseLayout>
