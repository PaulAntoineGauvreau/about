---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { career, profile, stackGroups, workPrinciples } from '../data/profile';
---

<BaseLayout
  title="Paul-Antoine Gauvreau — Développeur front-end à Montréal"
  description="Portfolio de Paul-Antoine Gauvreau, développeur front-end à Montréal : Craft CMS, Svelte, WordPress, Shopify et intégration web."
>
  <main id="contenu" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__topline">
        <p>Développeur front-end</p>
        <p>Montréal, QC</p>
      </div>

      <h1 id="hero-title" class="hero__title" aria-label={profile.name}>
        <span class="hero__line"><span data-hero-line>Paul-Antoine</span></span>
        <span class="hero__line"><span data-hero-line>Gauvreau</span></span>
      </h1>

      <div class="hero__intro grid gap-8 lg:grid-cols-12">
        <p class="hero__statement lg:col-span-7">{profile.introduction}</p>
        <div class="hero__note lg:col-span-4 lg:col-start-9">
          <span aria-hidden="true">✦</span>
          <p><strong>Premier projet Astro.</strong> Construit pour apprendre l’outil en produisant une preuve concrète.</p>
        </div>
      </div>

      <a class="hero__scroll" href="#projets">
        Voir les projets
        <span aria-hidden="true">↓</span>
      </a>
    </section>

    <section id="projets" class="page-section page-section--projects" aria-labelledby="projects-title">
      <SectionHeading number="01" eyebrow="Travaux sélectionnés" title="Des projets livrés, pas des mots-clés." id="projects-title" />
      <ProjectGrid />
    </section>

    <section id="methode" class="page-section page-section--dark" aria-labelledby="method-title">
      <SectionHeading number="02" eyebrow="Ma façon de travailler" title="Rendre le processus aussi solide que l’interface." id="method-title" />
      <div class="principles-grid grid md:grid-cols-2">
        {
          workPrinciples.map((principle) => (
            <article class="principle-card">
              <p class="principle-card__number">{principle.number}</p>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))
        }
      </div>
      <div class="quality-note grid gap-10 lg:grid-cols-12">
        <p class="quality-note__lead lg:col-span-6">Performance, accessibilité et SEO sont des critères de livraison.</p>
        <p class="quality-note__body lg:col-span-5 lg:col-start-8">
          Images adaptatives, navigation au clavier, mouvement réduit, structure sémantique et métadonnées font partie du travail. Les scores de production seront publiés seulement après une mesure réelle du site déployé.
        </p>
      </div>
    </section>

    <section class="page-section page-section--stack" aria-labelledby="stack-title">
      <SectionHeading number="03" eyebrow="Stack" title="Des outils choisis selon le projet." id="stack-title" />
      <div class="stack-grid grid md:grid-cols-2 xl:grid-cols-4">
        {
          stackGroups.map((group) => (
            <article class="stack-group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="page-section page-section--career" aria-labelledby="career-title">
      <SectionHeading number="04" eyebrow="Parcours" title="Design, gestion, puis développement." id="career-title" />
      <ol class="career-list">
        {
          career.map((item) => (
            <li class="career-list__item">
              <p>{item.period}</p>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/cv/">Voir le CV complet <span aria-hidden="true">→</span></a>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <p class="contact__eyebrow">05 · Contact</p>
      <h2 id="contact-title">On devrait<br />se parler.</h2>
      <div class="contact__actions">
        <copy-email class="copy-email" data-email={profile.email}>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <button type="button" data-copy-button>Copier</button>
          <span class="sr-only" aria-live="polite" data-copy-status></span>
        </copy-email>
        <a href={`tel:${profile.phoneHref}`}>{profile.phoneDisplay}</a>
      </div>
    </section>
  </main>
</BaseLayout>
