---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerSection from '../components/sections/CareerSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import MethodSection from '../components/sections/MethodSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import StackSection from '../components/sections/StackSection.astro';
---

<BaseLayout
  title="Paul-Antoine Gauvreau — Développeur front-end à Montréal"
  description="Portfolio de Paul-Antoine Gauvreau, développeur front-end à Montréal : Craft CMS, Svelte, WordPress, Shopify et intégration web."
>
  <main id="contenu" tabindex="-1">
    <HeroSection />
    <ProjectsSection />
    <MethodSection />
    <StackSection />
    <CareerSection />
    <ContactSection />
  </main>
</BaseLayout>
