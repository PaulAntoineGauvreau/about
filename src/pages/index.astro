---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { career, profile, stackGroups, workPrinciples } from '../data/profile';
---

<BaseLayout
  title="Paul-Antoine Gauvreau — Développeur front-end à Montréal"
  description="Portfolio de Paul-Antoine Gauvreau, développeur front-end à Montréal : Craft CMS, Svelte, WordPress, Shopify et intégration web."
>
  <main id="contenu" tabindex="-1">
    <section
      class="hero relative flex min-h-[100svh] flex-col justify-between overflow-hidden bg-orange px-page pt-hero-top pb-8 md:min-h-hero"
      aria-labelledby="hero-title"
    >
      <div class="hero__topline flex justify-between gap-4 text-eyebrow font-bold tracking-[0.06em] uppercase">
        <p class="m-0">Développeur front-end</p>
        <p class="m-0">Montréal, QC</p>
      </div>

      <h1
        id="hero-title"
        class="hero__title my-hero-title text-hero-mobile font-black tracking-[-0.09em] md:text-hero"
        aria-label={profile.name}
      >
        <span class="hero__line block overflow-hidden pr-[0.08em]"><span class="block will-change-[transform,opacity]" data-hero-line>Paul-Antoine</span></span>
        <span class="hero__line block overflow-hidden pr-[0.08em] md:pl-hero-indent"><span class="block will-change-[transform,opacity]" data-hero-line>Gauvreau</span></span>
      </h1>

      <div class="hero__intro mt-auto grid items-end gap-8 lg:grid-cols-12">
        <p class="hero__statement m-0 max-w-[34ch] text-statement font-bold tracking-[-0.04em] lg:col-span-7">{profile.introduction}</p>
        <div class="hero__note grid grid-cols-[auto_1fr] items-start gap-3 border-t border-ink pt-4 text-sm lg:col-span-4 lg:col-start-9">
          <span aria-hidden="true">✦</span>
          <p class="m-0"><strong>Premier projet Astro.</strong> Construit pour apprendre l’outil en produisant une preuve concrète.</p>
        </div>
      </div>

      <a class="hero__scroll group mt-10 inline-flex items-center gap-3 self-end text-xs font-bold tracking-[0.06em] uppercase no-underline" href="#projets">
        Voir les projets
        <span class="grid size-8 place-items-center rounded-full border border-current transition-transform duration-200 group-hover:translate-y-1" aria-hidden="true">↓</span>
      </a>
    </section>

    <section id="projets" class="page-section page-section--projects bg-paper px-page py-section" aria-labelledby="projects-title">
      <SectionHeading number="01" eyebrow="Travaux sélectionnés" title="Des projets livrés, pas des mots-clés." id="projects-title" />
      <ProjectGrid />
    </section>

    <section id="methode" class="page-section page-section--dark bg-ink px-page py-section text-cream" aria-labelledby="method-title">
      <SectionHeading number="02" eyebrow="Ma façon de travailler" title="Rendre le processus aussi solide que l’interface." id="method-title" />
      <div class="principles-grid grid border-t border-l border-cream/30 md:grid-cols-2">
        {
          workPrinciples.map((principle) => (
            <article class="principle-card flex min-h-60 flex-col border-r border-b border-cream/30 p-principle-pad md:min-h-76">
              <p class="principle-card__number m-0 mb-auto text-xs">{principle.number}</p>
              <h3 class="mt-12 mb-3 text-principle tracking-[-0.05em]">{principle.title}</h3>
              <p class="m-0 max-w-[42ch] text-cream/75">{principle.text}</p>
            </article>
          ))
        }
      </div>
      <div class="quality-note grid items-end gap-10 pt-quality-top lg:grid-cols-12">
        <p class="quality-note__lead m-0 text-lead font-extrabold tracking-[-0.06em] lg:col-span-6">Performance, accessibilité et SEO sont des critères de livraison.</p>
        <p class="quality-note__body m-0 text-cream/75 lg:col-span-5 lg:col-start-8">
          Images adaptatives, navigation au clavier, mouvement réduit, structure sémantique et métadonnées font partie du travail. Les scores de production seront publiés seulement après une mesure réelle du site déployé.
        </p>
      </div>
    </section>

    <section class="page-section page-section--stack bg-cream px-page py-section" aria-labelledby="stack-title">
      <SectionHeading number="03" eyebrow="Stack" title="Des outils choisis selon le projet." id="stack-title" />
      <div class="stack-grid grid border-t border-l border-ink/25 md:grid-cols-2 xl:grid-cols-4">
        {
          stackGroups.map((group) => (
            <article class="stack-group min-h-84 border-r border-b border-ink/25 p-stack-pad">
              <h3 class="mt-0 mb-14 text-xs tracking-[0.06em] uppercase">{group.title}</h3>
              <ul class="m-0 list-none p-0">
                {group.items.map((item) => <li class="text-stack tracking-[-0.035em]">{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="page-section page-section--career bg-career px-page py-section" aria-labelledby="career-title">
      <SectionHeading number="04" eyebrow="Parcours" title="Design, gestion, puis développement." id="career-title" />
      <ol class="career-list m-0 mb-12 list-none border-t border-ink p-0">
        {
          career.map((item) => (
            <li class="career-list__item grid grid-cols-1 gap-3 border-b border-ink py-6 md:grid-cols-[1fr_2fr_2fr] md:gap-6">
              <p class="m-0 text-xs font-bold tracking-[0.05em] uppercase">{item.period}</p>
              <h3 class="m-0 text-career-title tracking-[-0.04em]">{item.title}</h3>
              <p class="m-0 max-w-[46ch]">{item.detail}</p>
            </li>
          ))
        }
      </ol>
      <a class="text-link group inline-flex items-center gap-3 font-bold underline-offset-4" href="/cv/">Voir le CV complet <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></a>
    </section>

    <section id="contact" class="contact flex min-h-[70svh] flex-col justify-between bg-orange px-page pt-section pb-8 md:min-h-[85svh]" aria-labelledby="contact-title">
      <p class="contact__eyebrow m-0 text-xs font-bold tracking-[0.07em] uppercase">05 · Contact</p>
      <h2 id="contact-title" class="my-12 text-contact-mobile font-black tracking-[-0.09em] md:text-contact">On devrait<br />se parler.</h2>
      <div class="contact__actions flex flex-col items-start justify-between gap-x-8 gap-y-4 border-t border-ink pt-5 md:flex-row md:flex-wrap md:items-center">
        <copy-email class="copy-email flex flex-wrap items-center gap-3" data-email={profile.email}>
          <a class="text-action font-bold" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="hidden cursor-pointer rounded-full border border-current bg-transparent px-3 py-1 text-xs font-bold tracking-[0.05em] uppercase" type="button" data-copy-button>Copier</button>
          <span class="sr-only" aria-live="polite" data-copy-status></span>
        </copy-email>
        <a class="text-action font-bold" href={`tel:${profile.phoneHref}`}>{profile.phoneDisplay}</a>
      </div>
    </section>
  </main>
</BaseLayout>
