---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  complementaryExperiences,
  education,
  experiences,
  profile,
  stackGroups,
} from '../../data/profile';
---

<BaseLayout
  title="CV — Paul-Antoine Gauvreau, développeur front-end"
  description="CV de Paul-Antoine Gauvreau : développement front-end, design et gestion de projet à Montréal."
  canonicalPath="/cv/"
>
  <main id="contenu" class="mx-auto w-full max-w-380 px-4 pt-28 pb-20 md:px-8 md:pt-36 md:pb-24 lg:px-12 lg:pt-44 lg:pb-32" data-cv tabindex="-1">
    <header class="pb-16 md:pb-24 lg:pb-32" data-cv-hero>
      <p class="mt-0 mb-8 text-3 font-bold tracking-8 uppercase" data-cv-kicker>Curriculum vitæ · 2026</p>
      <h1 class="m-0 max-w-240 text-18 leading-76 font-black -tracking-8 md:text-32 lg:text-52">{profile.name}</h1>
      <p class="mt-8 mb-0 text-6 leading-100 font-bold -tracking-4 md:mt-12 md:text-9 lg:mt-16 lg:text-14" data-cv-role>Développeur front-end · Design · Gestion de projet</p>
      <p class="mt-6 mb-0 max-w-248 text-4 leading-128 md:text-5 lg:text-6" data-cv-summary>{profile.introduction}</p>
      <address class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-4 font-bold not-italic" data-cv-contact>
        <span>{profile.location}</span>
        <a href={`tel:${profile.phoneHref}`}>{profile.phoneDisplay}</a>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.website}>pagauvreau.com</a>
      </address>
      <button class="mt-8 cursor-pointer rounded-full border border-foreground bg-foreground px-4 py-3 text-3 font-bold tracking-4 text-surface uppercase" type="button" data-print-cv>Imprimer / PDF</button>
    </header>

    <section class="grid grid-cols-1 gap-8 border-t-2 border-foreground py-12 md:grid-cols-4 md:gap-16 md:py-16 lg:gap-28 lg:py-24" data-cv-section aria-labelledby="experience-title">
      <h2 class="m-0 text-5 leading-104 -tracking-4 md:col-span-1 md:text-6 lg:text-8" id="experience-title"><span class="mb-3 block text-3 tracking-4">01</span> Expériences de travail</h2>
      <div class="md:col-span-3">
        {
          experiences.map((experience) => (
            <article class="mb-10 grid grid-cols-1 gap-3 border-b border-foreground/25 pb-10 last:mb-0 md:grid-cols-3 md:gap-6" data-cv-entry>
              <p class="m-0 text-3 font-bold tracking-4 uppercase md:col-span-1">{experience.period}</p>
              <div class="md:col-span-2">
                <h3 class="mt-0 mb-2 text-6 leading-100 -tracking-4 md:text-8 lg:text-11">{experience.title}</h3>
                {experience.organizations.map((organization) => <p class="m-0 font-bold">{organization}</p>)}
                <p class="mt-5 mb-0 max-w-248 text-foreground/75" data-cv-description>{experience.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="grid grid-cols-1 gap-8 border-t-2 border-foreground py-12 md:grid-cols-4 md:gap-16 md:py-16 lg:gap-28 lg:py-24" data-cv-section aria-labelledby="complementary-title">
      <h2 class="m-0 text-5 leading-104 -tracking-4 md:col-span-1 md:text-6 lg:text-8" id="complementary-title"><span class="mb-3 block text-3 tracking-4">02</span> Expériences complémentaires</h2>
      <div class="md:col-span-3">
        {
          complementaryExperiences.map((experience) => (
            <article class="mb-6 grid grid-cols-1 gap-3 border-b border-foreground/25 pb-6 last:mb-0 md:grid-cols-3 md:gap-6" data-cv-entry>
              <p class="m-0 text-3 font-bold tracking-4 uppercase md:col-span-1">{experience.period}</p>
              <div class="md:col-span-2">
                <h3 class="mt-0 mb-2 text-6 leading-100 -tracking-4 md:text-8 lg:text-11">{experience.title}</h3>
                <p class="m-0 font-bold">{experience.organization}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="grid grid-cols-1 gap-8 border-t-2 border-foreground py-12 md:grid-cols-4 md:gap-16 md:py-16 lg:gap-28 lg:py-24" data-cv-section aria-labelledby="education-title">
      <h2 class="m-0 text-5 leading-104 -tracking-4 md:col-span-1 md:text-6 lg:text-8" id="education-title"><span class="mb-3 block text-3 tracking-4">03</span> Études</h2>
      <div class="md:col-span-3">
        {
          education.map((item) => (
            <article class="mb-6 grid grid-cols-1 gap-3 border-b border-foreground/25 pb-6 last:mb-0 md:grid-cols-3 md:gap-6" data-cv-entry>
              <p class="m-0 text-3 font-bold tracking-4 uppercase md:col-span-1">{item.period}</p>
              <div class="md:col-span-2">
                <h3 class="mt-0 mb-2 text-6 leading-100 -tracking-4 md:text-8 lg:text-11">{item.title}</h3>
                <p class="m-0 font-bold">{item.organization}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="grid grid-cols-1 gap-8 border-t-2 border-foreground py-12 md:grid-cols-4 md:gap-16 md:py-16 lg:gap-28 lg:py-24" data-cv-section aria-labelledby="skills-title">
      <h2 class="m-0 text-5 leading-104 -tracking-4 md:col-span-1 md:text-6 lg:text-8" id="skills-title"><span class="mb-3 block text-3 tracking-4">04</span> Compétences</h2>
      <div class="grid border-t border-l border-foreground/25 md:col-span-3 md:grid-cols-2" data-cv-skills>
        {
          stackGroups.map((group) => (
            <article class="border-r border-b border-foreground/25 p-6">
              <h3 class="mt-0 mb-4 text-3 tracking-4 uppercase">{group.title}</h3>
              <p class="m-0 text-4 leading-128 md:text-5 lg:text-6">{group.items.join(' · ')}</p>
            </article>
          ))
        }
      </div>
    </section>

    <p class="mt-16 mb-0 font-bold" data-cv-back><a href="/">← Retour au portfolio</a></p>
  </main>

  <script>
    function setupPrintButton() {
      document.querySelector('[data-print-cv]')?.addEventListener('click', () => window.print(), { once: true });
    }
    document.addEventListener('astro:page-load', setupPrintButton);
  </script>
</BaseLayout>
