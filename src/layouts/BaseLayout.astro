---
import Button from '../components/Button.astro';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL('/og-cover.png', Astro.site ?? Astro.url.origin).href;
const currentPath = Astro.url.pathname;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.website,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  jobTitle: profile.role,
  homeLocation: {
    '@type': 'Place',
    name: `${profile.location}, Québec, Canada`,
  },
  knowsAbout: [
    'Développement front-end',
    'Design web',
    'Accessibilité web',
    'WordPress',
    'Shopify',
    'Craft CMS',
  ],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth scroll-pt-24 overflow-x-clip bg-foreground motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content={profile.name} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff5a3d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paul-Antoine Gauvreau, développeur front-end à Montréal" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="m-0 min-w-80 overflow-x-clip bg-background font-sans text-fluid-body text-foreground">
    <a class="fixed top-gutter left-gutter z-100 -translate-y-[200%] rounded-2 bg-surface px-4 py-3 font-mono text-fluid-caption font-bold uppercase text-foreground focus:translate-y-0" href="#contenu" data-skip-link>Aller au contenu</a>

    <header class="absolute top-header-offset right-gutter left-gutter z-20 flex flex-col items-start gap-2 text-foreground bp:right-auto" data-site-header>
      <div class="flex w-full items-center justify-between gap-3 rounded-shell bg-surface p-2 bp:w-auto">
        <a class="inline-flex min-h-11 w-brand-slot flex-none items-center justify-center rounded-2 bg-foreground px-4 font-sans text-fluid-body font-black tracking-[-0.04em] text-surface no-underline" href="/" aria-label="PAG — Accueil de Paul-Antoine Gauvreau">
          PAG
        </a>
        <nav class="flex min-w-0 items-center font-mono text-fluid-caption font-bold uppercase" aria-label="Navigation principale">
          <a class="hidden min-h-11 items-center justify-center rounded-2 px-4 pt-1 pb-0 leading-100 no-underline bp:inline-flex" href="/#projets">Projets</a>
          <a class="hidden min-h-11 items-center justify-center rounded-2 px-4 pt-1 pb-0 leading-100 no-underline bp:inline-flex" href="/#musique">Musique</a>
          <a class:list={['hidden min-h-11 items-center justify-center rounded-2 px-4 pt-1 pb-0 leading-100 no-underline bp:inline-flex', currentPath.startsWith('/cv') && 'bg-accent']} href="/cv/" aria-current={currentPath.startsWith('/cv') ? 'page' : undefined}>CV</a>
          <Button variant="primary" href="/#contact">Contact</Button>
        </nav>
      </div>
      <div class="hidden w-full items-center justify-between gap-2 rounded-2 bg-surface px-3 py-2 font-mono text-fluid-caption font-bold uppercase bp:flex" data-header-meta>
        <p>Aujourd'hui</p>
        <span aria-hidden="true">·</span>
        <p>Montréal, QC</p>
        <span aria-hidden="true">·</span>
        <montreal-weather>
          <p aria-live="polite">
            <span class="inline-flex min-h-6 items-center gap-2" aria-busy="true" data-weather>
              <span class="inline-grid min-w-16 place-items-center" data-temperature>
                <span class="h-4 w-12 animate-pulse rounded-1 bg-border" aria-hidden="true"></span>
                <span class="sr-only">Température en chargement</span>
              </span>
              <span aria-hidden="true">·</span>
              <span class="inline-grid size-6 place-items-center" data-weather-icon aria-hidden="true">
                <span class="size-5 animate-pulse rounded-full bg-border"></span>
              </span>
              <span class="sr-only" data-weather-label>Météo en chargement.</span>
              <span class="inline-grid size-6 place-items-center" data-bike aria-hidden="true">
                <span class="size-5 animate-pulse rounded-full bg-border"></span>
              </span>
              <span class="sr-only" data-bike-label></span>
            </span>
          </p>
        </montreal-weather>
      </div>
    </header>
    <slot />
    <!-- <footer class="flex flex-col items-start justify-between gap-4 bg-foreground px-gutter py-5 font-mono text-fluid-caption uppercase text-surface bp:flex-row" data-site-footer>
      <p class="m-0">Paul-Antoine Gauvreau <span aria-hidden="true">—</span> Montréal</p>
      <a href="/typography/">Système typographique</a>
      <p class="m-0">Conçu et développé avec Astro, sans CMS.</p>
    </footer> -->

    <script>
      import '../scripts/web-components';

      const loadMotion = () => {
        window.requestAnimationFrame(() => void import('../scripts/motion'));
      };

      if (document.readyState === 'complete') {
        loadMotion();
      } else {
        window.addEventListener('load', loadMotion, { once: true });
      }
    </script>
  </body>
</html>
