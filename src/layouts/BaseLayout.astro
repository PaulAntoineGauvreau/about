---
import { ClientRouter } from 'astro:transitions';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  bodyClass = '',
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL('/og-cover.png', Astro.site ?? Astro.url.origin).href;
const currentPath = Astro.url.pathname;
const navLinkClass = "relative no-underline after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-200 hover:after:origin-left hover:after:scale-x-100 aria-[current=page]:after:origin-left aria-[current=page]:after:scale-x-100";

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.website,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  jobTitle: profile.role,
  homeLocation: {
    '@type': 'Place',
    name: `${profile.location}, Québec, Canada`,
  },
  knowsAbout: [
    'Développement front-end',
    'Design web',
    'Accessibilité web',
    'WordPress',
    'Shopify',
    'Craft CMS',
  ],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth scroll-pt-24 overflow-x-clip bg-ink motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content={profile.name} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ff5a3d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Paul-Antoine Gauvreau, développeur front-end à Montréal" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body
    class:list={[
      'm-0 min-w-80 overflow-x-clip bg-paper font-sans text-body text-ink [text-rendering:optimizeLegibility]',
      bodyClass,
    ]}
  >
    <a
      class="skip-link fixed top-3 left-3 z-100 -translate-y-[180%] bg-ink px-4 py-3 font-bold text-cream transition-transform duration-200 focus:translate-y-0"
      href="#contenu"
    >Aller au contenu</a>

    <header
      class="site-header absolute inset-x-0 top-0 z-20 flex items-start justify-between gap-4 border-b border-ink/30 px-page py-4 text-ink md:items-center"
      data-site-header
    >
      <a
        class="site-header__mark group inline-flex items-center gap-1 text-base font-black tracking-[-0.04em] no-underline"
        href="/"
        aria-label="PAG — Accueil de Paul-Antoine Gauvreau"
      >
        PAG<span class="transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span>
      </a>
      <nav
        class="site-header__nav grid grid-cols-2 gap-x-4 gap-y-2 text-right text-nav font-bold tracking-[0.06em] uppercase md:flex md:items-center md:gap-nav-gap"
        aria-label="Navigation principale"
      >
        <a class={navLinkClass} href="/#projets">Projets</a>
        <a class={navLinkClass} href="/#methode">Méthode</a>
        <a class={navLinkClass} href="/cv/" aria-current={currentPath.startsWith('/cv') ? 'page' : undefined}>CV</a>
        <a class={navLinkClass} href="/#contact">Contact</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer flex flex-col items-start justify-between gap-4 bg-ink px-page py-5 text-xs tracking-[0.05em] text-cream uppercase md:flex-row">
      <p class="m-0">Paul-Antoine Gauvreau <span aria-hidden="true">—</span> Montréal</p>
      <p class="m-0">Conçu et développé avec Astro, sans CMS.</p>
    </footer>

    <script>
      import '../scripts/web-components';
      import '../scripts/motion';
    </script>
  </body>
</html>
